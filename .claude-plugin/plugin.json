{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "summer",
  "version": "1.4.0",
  "description": "AI game-dev studio for Godot/Summer projects: 12 workflow skills + 7 specialists + lifecycle hooks + MCP bridge to the local Summer Engine.",
  "author": {
    "name": "Summer Engine",
    "email": "founders@summerengine.com",
    "url": "https://summerengine.com"
  },
  "homepage": "https://summerengine.com",
  "repository": "https://github.com/SummerEngine/summer-engine-cli",
  "license": "MIT",
  "keywords": [
    "game-dev",
    "godot",
    "summer-engine",
    "ai-game-engine",
    "skills",
    "workflow",
    "scene-design",
    "level-design",
    "art-direction",
    "vfx",
    "multiplayer",
    "performance"
  ],
  "skills": [
    "./skills/scene-and-project/brainstorm-game/",
    "./skills/debugging/debug/",
    "./skills/scene-and-project/play/",
    "./skills/gameplay-mechanics/design-mechanic/",
    "./skills/level-design/design-level/",
    "./skills/rendering-and-lighting/art-direction/",
    "./skills/audio/audio-direction/",
    "./skills/visual-effects/vfx/",
    "./skills/performance/tune-performance/",
    "./skills/ai-and-npcs/design-npc/",
    "./skills/multiplayer-and-networking/setup-multiplayer/",
    "./skills/deployment/export-and-ship/",
    "./skills/character-controllers/fps-controller/",
    "./skills/rendering-and-lighting/3d-lighting/",
    "./skills/scripting/gdscript-patterns/",
    "./skills/scene-and-project/scene-composition/",
    "./skills/ui/ui-basics/",
    "./skills/assets/asset-strategy/",
    "./skills/scene-and-project/make-game/"
  ],
  "hooks": "./hooks/hooks.json",
  "mcpServers": "./.mcp.json",
  "userConfig": {
    "enable_pre_commit_doctor": {
      "type": "boolean",
      "title": "Run summer doctor before commits",
      "description": "Block git commits when the Summer Engine setup has FAIL diagnostics. Off by default.",
      "default": false
    }
  }
}
