; Outcome-eval fixture `empty3d`: one Node3D root and nothing else (the Wave G
; waveg.tscn bootstrap shape). The runner copies this directory to a throwaway
; project before it boots the editor, so nothing in here is ever mutated in
; place. No .godot/ cache is committed; the editor regenerates it on boot. The
; [audio]/[rendering] pins keep the game child free of Vulkan/ALSA probing
; noise under Xvfb (they are environment pins, not part of the task).

config_version=5

[application]

config/name="Outcome Eval empty3d"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[audio]

driver/driver="Dummy"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
