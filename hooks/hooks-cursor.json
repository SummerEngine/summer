{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "matcher": "startup|clear|compact",
        "command": "./hooks/run-hook.cmd session-start",
        "async": false,
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "matcher": "git\\s+commit",
        "command": "./hooks/run-hook.cmd pre-commit-doctor",
        "async": false,
        "timeout": 30
      }
    ]
  }
}
