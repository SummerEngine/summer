{
  "name": "summer-engine",
  "version": "2.8.2",
  "description": "Local Summer CLI and MCP server for Summer Engine. Install and run the engine, connect Claude Code, Cursor, Codex, Gemini, and other agents, and build real games with bundled skills, hooks, and plugins.",
  "keywords": [
    "summer-engine",
    "summer-cli",
    "summer-mcp",
    "summer-agent",
    "summer-engine-agent",
    "game-engine",
    "ai-game-engine",
    "godot",
    "godot-ai",
    "mcp",
    "mcp-server",
    "claude-code",
    "cursor",
    "codex",
    "gamedev",
    "game-development",
    "3d",
    "ai"
  ],
  "homepage": "https://summerengine.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SummerEngine/summer-engine-agent.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "MIT",
  "author": "Summer Engine <founders@summerengine.com>",
  "type": "module",
  "main": ".opencode/plugins/summer.js",
  "bin": {
    "summer": "dist/bin/summer.js"
  },
  "files": [
    "dist/",
    "library/",
    "registry/generated/",
    "registry/schemas/",
    "integrations/",
    "commands/",
    "hooks/",
    "assets/",
    ".claude-plugin/",
    ".cursor-plugin/",
    ".codex-plugin/",
    ".factory-plugin/",
    ".opencode/",
    "gemini-extension.json",
    ".mcp.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "AGENTS.md",
    "GEMINI.md",
    "CLAUDE.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "dev": "tsc --watch",
    "summer": "node dist/bin/summer.js",
    "test": "vitest run && npm run validate:library",
    "validate:library": "node scripts/validate-library/cli.ts",
    "eval:routing": "node evals/routing/runner.ts",
    "eval:routing:heldout": "node evals/routing/runner.ts --heldout",
    "eval:canary": "node evals/canary/canary-gateway.ts",
    "eval:outcomes": "node evals/outcomes/runner.ts",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test",
    "generate:registry": "node scripts/generate-registry/cli.ts",
    "generate:product-map": "npm run build && node scripts/navigation/render-product-map.ts",
    "sync:web-routes": "npm run build && node scripts/navigation/sync-web-routes.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^12.0.0",
    "open": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.4",
    "yaml": "^2.9.0"
  }
}
